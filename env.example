APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=replace-with-at-least-14-characters
STORE_NAME=ShopEasy
STORE_EMAIL=support@yourstore.com
STORE_PHONE=+92XXXXXXXXXX
STORE_WHATSAPP=92XXXXXXXXXX
STORE_HOURS=Monday-Saturday, 10:00-18:00 PKT
STORE_ADDRESS=Your business address
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
DATABASE_PATH=store.db

# Transactional email (required for order notifications and customer email 2FA)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=orders@yourstore.com
SMTP_USE_SSL=false
